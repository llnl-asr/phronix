# Rendered per-harness artifacts. The source of truth is the YAML templates under
# .agents/agents/ and the skills under .agents/skills/ — these are regenerated by
# `phronix sync`, and committing them would produce a diff on every model-map
# change for files nobody edits.
.claude/agents/
.opencode/agents/
.github/agents/
.codex/agents/
.claude/skills/
.opencode/skills/
.claude/hooks/
.codex/hooks/
.opencode/plugin/

# The live harness/provider choice is a local decision, not a shared one.
active-models.json

# Local secrets. .env holds a real API key; committing it publishes the key to
# everyone who clones, and rotating after the fact does not un-publish it.
.env
.env.*
!.env.example

# Benchmark output: run directories hold full agent transcripts and patches, and
# the dataset cache is multi-GB. Both are reproducible from the pinned task list.
tests/benchmark/runs/
tests/benchmark/.dataset/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.tox/
src/phronix/_version.py

# Knowledge-graph cache (staged copies and graph.json)
.phronix-cache/
graphify-out/

# Per-session research. Each run writes here so it cannot read its way out of
# its own isolation; `phronix research sync` folds a finished session into
# .phronix/research/, which IS committed. The working state of every run that
# ever started is not worth a diff.
.phronix/research/sessions/

# Run bookkeeping: which pid, on which host, for which run directory. Written by
# scripts/go.sh so a run started in one allocation can still be found and killed
# from another — pgrep only sees the node it runs on. Local state, not shared.
logs/
