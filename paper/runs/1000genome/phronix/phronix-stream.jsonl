line from counter to stop and we don't over total, then we remove lines starting with '#'\n56\t    #sed -n \"$counter\"','\"$stop\"'p;'\"$total\"'q' $unzipped | grep -ve \"#\" > cc\n57\t    regex = re.compile('(?!#)')\n58\t    # print(counter, min(stop, total), data[int(counter):int(min(stop, total))] )\n59\t    data = list(filter(regex.match, rawdata[counter:ending]))\n60\t    data = [x.rstrip('\\n') for x in data] # Remove \\n from words \n61\t\n62\t    chrp_data = {}\n63\t    columndata = readfile(columfile)[0].rstrip('\\n').split('\\t')\n64\t\n65\t    start_data = 9  # where the real data start, the first 0|1, 1|1, 1|0 or 0|0\n66\t    # position of the last element (normally equals to len(data[0].split(' '))\n67\t    #end_data = 2504\n68\t    end_data = len(columndata) - start_data\n69\t    print(\"== Number of columns {}\".format(end_data))\n70\t\n71\t    for i in range(0, end_data):\n72\t        col = i + start_data\n73\t        name = columndata[col]\n74\t\n75\t        filename = \"{}/chr{}.{}\".format(ndir, c, name)\n76\t        print(\"=== Writing file {}\".format(filename), end=\" => \")\n77\t        tic_iter = time.perf_counter()\n78\t        chrp_data[i] = []\n79\t\n80\t        with open(filename, 'w') as f:\n81\t            for line in data:\n82\t                #print(i, line.split('\\t'))\n83\t                first = line.split('\\t')[col]  # first =`echo $l | cut -d -f$i`\n84\t                #second =`echo $l | cut -d -f 2, 3, 4, 5, 8 --output-delimiter = '   '`\n85\t                second = line.split('\\t')[0:8]\n86\t                # We select the one we want\n87\t                second = [elem for id, elem in enumerate(second) if id in [1, 2, 3, 4, 7]]\n88\t                af_value = second[4].split(';')[8].split('=')[1]\n89\t                # We replace with AF_Value\n90\t                second[4] = af_value\n91\t                try:\n92\t                    if ',' in af_value:\n93\t                        # We only keep the first value if more than one (that's what awk is doing)\n94\t                        af_value = float(af_value.split(',')[0])\n95\t                    else:\n96\t                        af_value = float(af_value)\n97\t\n98\t                    elem = first.split('|')\n99\t                    # We skip some lines that do not meet these conditions\n100\t                    if af_value >= 0.5 and elem[0] == '0':\n101\t                        chrp_data[i].append(second)\n102\t                    elif af_value < 0.5 and elem[0] == '1':\n103\t                        chrp_data[i].append(second)\n104\t                    else:\n105\t                        continue\n106\t\n107\t                    f.write(\"{0}        {1}    {2}    {3}    {4}\\n\".format(\n108\t                        second[0], second[1], second[2], second[3], second[4])\n109\t                    )\n110\t                except ValueError:\n111\t                    continue\n112\t\n113\t        print(\"processed in {:0.2f} sec\".format(time.perf_counter()-tic_iter))\n114\t\n115\t    outputfile = \"chr{}n-{}-{}.tar.gz\".format(c, counter, stop)\n116\t    print(\"== Done. Zipping {} files into {}.\".format(end_data, outputfile))\n117\t\n118\t    # tar -zcf .. /$outputfile .\n119\t    compress(outputfile, ndir)\n120\t\n121\t    # Cleaning temporary files\n122\t    try:\n123\t        shutil.rmtree(ndir)\n124\t    except OSError as e:\n125\t        print(\"Error: %s : %s\" % (ndir, e.strerror))\n126\t\n127\t    print(\"= Chromosome {} processed in {:0.2f} seconds.\".format(c, time.perf_counter() - tic))\n128\t\n129\tif __name__ == \"__main__\":\n130\t    with DFTracerFn(\"io\", name=\"main\"):\n131\t        print(f\"Host = {os.uname()[1]}\")\n132\t        print(f\"CPUs = {os.sched_getaffinity(0)}\")\n133\t        inputfile = sys.argv[1]\n134\t        c = sys.argv[2]\n135\t        counter = sys.argv[3]\n136\t        stop = sys.argv[4]\n137\t        total = sys.argv[5]\n138\t        columfile = 'columns.txt'\n139\t\n140\t        processing(inputfile=inputfile,\n141\t                columfile=columfile,\n142\t                c=c,\n143\t                counter=counter,\n144\t                stop=stop,\n145\t                total=total)\n146\t    _dft_log.finalize()\n147\t"}]},"parent_tool_use_id":null,"session_id":"c8d376a6-3fd4-45e3-99c2-997c7d4a6c58","uuid":"86b010cb-38ba-4abe-aca0-008465f33b93","timestamp":"2026-09-15T23:23:26.836Z","tool_use_result":{"type":"text","file":{"filePath":"/usr/WS2/haridev/dftracer-agents/workspaces/1000genome_workflow/20260915_231313/annotated/bin/individuals.py","content":"#!/usr/bin/env python3\n\nimport os\nimport sys\nimport re\nimport time\nimport tarfile\nimport shutil\nfrom dftracer.python import dftracer, dft_fn as DFTracerFn\n_dft = DFTracerFn(\"io\")\n_dft_log = dftracer.initialize_log(logfile=None, data_dir=None, process_id=-1)\n\n\n@_dft.log\ndef compress(output, input_dir):\n    with tarfile.open(output, \"w:gz\") as file:\n        file.add(input_dir, arcname=os.path.basename(input_dir))\n\n@_dft.log\ndef readfile(file):\n    with open(file, 'r') as f:\n        content = f.readlines()\n    return content\n\n@_dft.log\ndef processing(inputfile, columfile, c, counter, stop, total):\n    print('= Now processing chromosome: {}'.format(c))\n    tic = time.perf_counter()\n\n    counter = int(counter)\n    ending = min(int(stop), int(total))\n    \n    ### step 0\n    unzipped = 'ALL.chr{}.individuals.vcf'.format(c)\n    # unzipped = os.path.splitext(inputfile)[0]  # Remove .gz\n\n    # shutil.move(inputfile, unzipped)\n\n    # if not os.path.exists(unzipped):\n    #     decompress(inputfile, unzipped)\n\n    rawdata = readfile(inputfile)\n\n    ### step 2\n    ## Giving a different directory name (chromosome no-counter) for each individuals job\n    ndir = 'chr{}n-{}/'.format(c, counter)\n    os.makedirs(ndir, exist_ok=True)\n\n    ### step 3\n    # In the bash version, counter started at 1 but in Python we start at 0. \n    # counter = max(0, counter - 1)  # The max ensure that we don't do -1 if the user set counter 0 directly\n    print(\"== Total number of lines: {}\".format(total))\n    print(\"== Processing {} from line {} to {}\".format(unzipped, counter, stop))\n\n    # We consider the line from counter to stop and we don't over total, then we remove lines starting with '#'\n    #sed -n \"$counter\"','\"$stop\"'p;'\"$total\"'q' $unzipped | grep -ve \"#\" > cc\n    regex = re.compile('(?!#)')\n    # print(counter, min(stop, total), data[int(counter):int(min(stop, total))] )\n    data = list(filter(regex.match, rawdata[counter:ending]))\n    data = [x.rstrip('\\n') for x in data] # Remove \\n from words \n\n    chrp_data = {}\n    columndata = readfile(columfile)[0].rstrip('\\n').split('\\t')\n\n    start_data = 9  # where the real data start, the first 0|1, 1|1, 1|0 or 0|0\n    # position of the last element (normally equals to len(data[0].split(' '))\n    #end_data = 2504\n    end_data = len(columndata) - start_data\n    print(\"== Number of columns {}\".format(end_data))\n\n    for i in range(0, end_data):\n        col = i + start_data\n        name = columndata[col]\n\n        filename = \"{}/chr{}.{}\".format(ndir, c, name)\n        print(\"=== Writing file {}\".format(filename), end=\" => \")\n        tic_iter = time.perf_counter()\n        chrp_data[i] = []\n\n        with open(filename, 'w') as f:\n            for line in data:\n                #print(i, line.split('\\t'))\n                first = line.split('\\t')[col]  # first =`echo $l | cut -d -f$i`\n                #second =`echo $l | cut -d -f 2, 3, 4, 5, 8 --output-delimiter = '   '`\n                second = line.split('\\t')[0:8]\n                # We select the one we want\n                second = [elem for id, elem in enumerate(second) if id in [1, 2, 3, 4, 7]]\n                af_value = second[4].split(';')[8].split('=')[1]\n                # We replace with AF_Value\n                second[4] = af_value\n                try:\n                    if ',' in af_value:\n                        # We only keep the first value if more than one (that's what awk is doing)\n                        af_value = float(af_value.split(',')[0])\n                    else:\n                        af_value = float(af_value)\n\n                    elem = first.split('|')\n                    # We skip some lines that do not meet these conditions\n                    if af_value >= 0.5 and elem[0] == '0':\n                        chrp_data[i].append(second)\n                    elif af_value < 0.5 and elem[0] == '1':\n                        chrp_data[i].append(second)\n                    else:\n                        continue\n\n                    f.write(\"{0}        {1}    {2}    {3}    {4}\\n\".format(\n                        second[0], second[1], second[2], second[3], second[4])\n                    )\n                except ValueError:\n                    continue\n\n        print(\"processed in {:0.2f} sec\".format(time.perf_counter()-tic_iter))\n\n    outputfile = \"chr{}n-{}-{}.tar.gz\".format(c, counter, stop)\n    print(\"== Done. Zipping {} files into {}.\".format(end_data, outputfile))\n\n    # tar -zcf .. /$outputfile .\n    compress(outputfile, ndir)\n\n    # Cleaning temporary files\n    try:\n        shutil.rmtree(ndir)\n    except OSError as e:\n        print(\"Error: %s : %s\" % (ndir, e.strerror))\n\n    print(\"= Chromosome {} processed in {:0.2f} seconds.\".format(c, time.perf_counter() - tic))\n\nif __name__ == \"__main__\":\n    with DFTracerFn(\"io\", name=\"main\"):\n        print(f\"Host = {os.uname()[1]}\")\n        print(f\"CPUs = {os.sched_getaffinity(0)}\")\n        inputfile = sys.argv[1]\n        c = sys.argv[2]\n        counter = sys.argv[3]\n        stop = sys.argv[4]\n        total = sys.argv[5]\n        columfile = 'columns.txt'\n\n        processing(inputfile=inputfile,\n                columfile=columfile,\n                c=c,\n                counter=counter,\n                stop=stop,\n                total=total)\n    _dft_log.finalize()\n","numLines":147,"startLine":1,"totalLines":147}}}
