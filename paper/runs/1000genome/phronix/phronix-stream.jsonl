{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LvaVA6JdDoVML5HfmZEKQd","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\n3\timport os\n4\timport sys\n5\timport re\n6\timport time\n7\timport tarfile\n8\timport shutil\n9\t\n10\tfrom dftracer.python import dftracer, dft_fn as DFTracerFn\n11\t\n12\t_dft = DFTracerFn(\"individuals\")\n13\t_dft_log = dftracer.initialize_log(logfile=None, data_dir=None, process_id=None)\n14\t\n15\t\n16\t@_dft.log\n17\tdef compress(output, input_dir):\n18\t    with tarfile.open(output, \"w:gz\") as file:\n19\t        file.add(input_dir, arcname=os.path.basename(input_dir))\n20\t\n21\t@_dft.log\n22\tdef readfile(file):\n23\t    with open(file, 'r') as f:\n24\t        content = f.readlines()\n25\t    return content\n26\t\n27\tdef processing(inputfile, columfile, c, counter, stop, total):\n28\t    print('= Now processing chromosome: {}'.format(c))\n29\t    tic = time.perf_counter()\n30\t\n31\t    counter = int(counter)\n32\t    ending = min(int(stop), int(total))\n33\t\n34\t    ### step 0\n35\t    unzipped = 'ALL.chr{}.individuals.vcf'.format(c)\n36\t    # unzipped = os.path.splitext(inputfile)[0]  # Remove .gz\n37\t\n38\t    # shutil.move(inputfile, unzipped)\n39\t\n40\t    # if not os.path.exists(unzipped):\n41\t    #     decompress(inputfile, unzipped)\n42\t\n43\t    with DFTracerFn(\"io\", name=\"vcf_read_parse\"):\n44\t        rawdata = readfile(inputfile)\n45\t\n46\t        ### step 2\n47\t        ## Giving a different directory name (chromosome no-counter) for each individuals job\n48\t        ndir = 'chr{}n-{}/'.format(c, counter)\n49\t        os.makedirs(ndir, exist_ok=True)\n50\t\n51\t        ### step 3\n52\t        # In the bash version, counter started at 1 but in Python we start at 0.\n53\t        # counter = max(0, counter - 1)  # The max ensure that we don't do -1 if the user set counter 0 directly\n54\t        print(\"== Total number of lines: {}\".format(total))\n55\t        print(\"== Processing {} from line {} to {}\".format(unzipped, counter, stop))\n56\t\n57\t        # We consider the line from counter to stop and we don't over total, then we remove lines starting with '#'\n58\t        #sed -n \"$counter\"','\"$stop\"'p;'\"$total\"'q' $unzipped | grep -ve \"#\" > cc\n59\t        regex = re.compile('(?!#)')\n60\t        # print(counter, min(stop, total), data[int(counter):int(min(stop, total))] )\n61\t        data = list(filter(regex.match, rawdata[counter:ending]))\n62\t        data = [x.rstrip('\\n') for x in data] # Remove \\n from words\n63\t\n64\t        chrp_data = {}\n65\t        columndata = readfile(columfile)[0].rstrip('\\n').split('\\t')\n66\t\n67\t        start_data = 9  # where the real data start, the first 0|1, 1|1, 1|0 or 0|0\n68\t        # position of the last element (normally equals to len(data[0].split(' '))\n69\t        #end_data = 2504\n70\t        end_data = len(columndata) - start_data\n71\t        print(\"== Number of columns {}\".format(end_data))\n72\t\n73\t    for i in range(0, end_data):\n74\t        col = i + start_data\n75\t        name = columndata[col]\n76\t\n77\t        filename = \"{}/chr{}.{}\".format(ndir, c, name)\n78\t        print(\"=== Writing file {}\".format(filename), end=\" => \")\n79\t        tic_iter = time.perf_counter()\n80\t        chrp_data[i] = []\n81\t\n82\t        with DFTracerFn(\"io\", name=\"write_individual\"):\n83\t            with open(filename, 'w') as f:\n84\t                for line in data:\n85\t                    #print(i, line.split('\\t'))\n86\t                    first = line.split('\\t')[col]  # first =`echo $l | cut -d -f$i`\n87\t                    #second =`echo $l | cut -d -f 2, 3, 4, 5, 8 --output-delimiter = '   '`\n88\t                    second = line.split('\\t')[0:8]\n89\t                    # We select the one we want\n90\t                    second = [elem for id, elem in enumerate(second) if id in [1, 2, 3, 4, 7]]\n91\t                    af_value = second[4].split(';')[8].split('=')[1]\n92\t                    # We replace with AF_Value\n93\t                    second[4] = af_value\n94\t                    try:\n95\t                        if ',' in af_value:\n96\t                            # We only keep the first value if more than one (that's what awk is doing)\n97\t                            af_value = float(af_value.split(',')[0])\n98\t                        else:\n99\t                            af_value = float(af_value)\n100\t\n101\t                        elem = first.split('|')\n102\t                        # We skip some lines that do not meet these conditions\n103\t                        if af_value >= 0.5 and elem[0] == '0':\n104\t                            chrp_data[i].append(second)\n105\t                        elif af_value < 0.5 and elem[0] == '1':\n106\t                            chrp_data[i].append(second)\n107\t                        else:\n108\t                            continue\n109\t\n110\t                        f.write(\"{0}        {1}    {2}    {3}    {4}\\n\".format(\n111\t                            second[0], second[1], second[2], second[3], second[4])\n112\t                        )\n113\t                    except ValueError:\n114\t                        continue\n115\t\n116\t        print(\"processed in {:0.2f} sec\".format(time.perf_counter()-tic_iter))\n117\t\n118\t    outputfile = \"chr{}n-{}-{}.tar.gz\".format(c, counter, stop)\n119\t    print(\"== Done. Zipping {} files into {}.\".format(end_data, outputfile))\n120\t\n121\t    # tar -zcf .. /$outputfile .\n122\t    with DFTracerFn(\"io\", name=\"compress_individuals\"):\n123\t        compress(outputfile, ndir)\n124\t\n125\t    # Cleaning temporary files\n126\t    try:\n127\t        shutil.rmtree(ndir)\n128\t    except OSError as e:\n129\t        print(\"Error: %s : %s\" % (ndir, e.strerror))\n130\t\n131\t    print(\"= Chromosome {} processed in {:0.2f} seconds.\".format(c, time.perf_counter() - tic))\n132\t\n133\tif __name__ == \"__main__\":\n134\t    print(f\"Host = {os.uname()[1]}\")\n135\t    print(f\"CPUs = {os.sched_getaffinity(0)}\")\n136\t    inputfile = sys.argv[1]\n137\t    c = sys.argv[2]\n138\t    counter = sys.argv[3]\n139\t    stop = sys.argv[4]\n140\t    total = sys.argv[5]\n141\t    columfile = 'columns.txt'\n142\t\n143\t    processing(inputfile=inputfile,\n144\t            columfile=columfile,\n145\t            c=c,\n146\t            counter=counter,\n147\t            stop=stop,\n148\t            total=total)\n149\t\n150\t    _dft_log.finalize()\n151\t"}]},"parent_tool_use_id":"toolu_01B71dRMatiezHx7aRJotjX3","session_id":"afb86d9e-6ad6-45f6-ad84-a569d8db98ea","uuid":"83828805-557d-480d-969f-68485c3ec656","timestamp":"2026-09-16T00:05:21.256Z","subagent_type":"general-purpose","task_description":"Run 1000genome dftracer pipeline steps 1-7"}
